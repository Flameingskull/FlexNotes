{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      "opencode.json": "deny",
      "README.md": "deny",
      "RELEASE_NOTES.md": "deny",
      ".claude/*": "deny",
      ".github/workflows/build.yml": "deny",
      "docs/*": "deny",
      "*.keystore": "deny",
      "*.jks": "deny"
    },
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "python -I .github/scripts/unused_private.py*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "gh *": "deny",
      "./gradlew*": "deny",
      "gradlew*": "deny",
      "gradle *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pip *": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
