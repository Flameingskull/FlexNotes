<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (#220), filled in by TodayWidgets.render: the date, today's doses and the workout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/notification_character" />

        <TextView
            android:id="@+id/widget_title"
        android:textColor="#FFF2BE22"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="@string/tw_name" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_doses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_more"
        android:textColor="#FFBDB6A8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_workout_label"
        android:textColor="#FFF2BE22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/widget_workout"
        android:textColor="#FFF7F3EA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="14sp" />
</LinearLayout>
